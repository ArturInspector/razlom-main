# Razlom — FiveM Server Configuration (Example)
# Скопируйте в server.cfg и замените значения

## Основные настройки
sv_hostname "Razlom | Invasion Survival RP"
sv_maxclients 64
sets sv_projectName "Razlom"
sets sv_projectDesc "Post-apocalyptic survival with invasion mechanics"

## Сетевые настройки
endpoint_add_tcp "0.0.0.0:30120"
endpoint_add_udp "0.0.0.0:30120"

## Лицензионные ключи (ОБЯЗАТЕЛЬНО ЗАМЕНИТЬ!)
sv_licenseKey "YOUR_LICENSE_KEY_HERE"

## База данных (НАСТРОИТЬ!)
setr mysql_connection_string "mysql://username:password@localhost/database?charset=utf8mb4"

## OneSync
set onesync on

## Базовые ресурсы FiveM (обязательные)
ensure mapmanager
ensure chat
ensure spawnmanager
ensure sessionmanager
ensure basic-gamemode
ensure hardcap

## Razlom ресурсы
ensure oxmysql
ensure apo_ui
ensure apo_zones
ensure apo_invasion
ensure apo_economy
ensure apo_reputation
ensure apo_tutorial
ensure apo_progression
ensure apo_signal

## Для тестирования (опционально)
# ensure test_spawn

